<Window x:Class="ProsoftAutoLogin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Prosoft Auto Login"
        Width="680"
        Height="660"
        MinWidth="580"
        MinHeight="560"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24,18,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Prosoft Auto Login"
                       FontSize="24"
                       FontWeight="SemiBold" />
            <TextBlock Text="MVP — เข้าสู่ระบบ Prosoft และเปิดหน้าซื้อเชื่ออัตโนมัติ"
                       Margin="0,4,0,0"
                       Foreground="#666666" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,14">
            <TextBlock Text="Profile (ฐานข้อมูล)"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4" />
            <TextBox x:Name="ProfileInput"
                     Height="32"
                     Padding="8,4"
                     Text="Nts"
                     Margin="0,0,0,8" />
            <TextBlock Text="User Name (ไม่ระบุก็ได้ — จะใช้ค่าเดิมใน Prosoft)"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4" />
            <TextBox x:Name="UsernameInput"
                     Height="32"
                     Padding="8,4"
                     Text="0114029"
                     Margin="0,0,0,8" />
            <TextBlock Text="Password (ถ้าเปิดโปรแกรม Prosoft ไว้อยู่แล้ว ไม่ต้องกรอกก็ได้)"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4" />
            <PasswordBox x:Name="PasswordInput"
                         Height="32"
                         Padding="8,4"
                         KeyDown="PasswordInput_KeyDown" />
            <TextBlock Text="โปรแกรมจะไม่บันทึกรหัสผ่าน"
                       Margin="0,4,0,0"
                       FontSize="12"
                       Foreground="#777777" />
            <CheckBox x:Name="OpenCreditPurchaseCheckBox"
                      Content="เปิดหน้าซื้อเชื่อ (PO Data Entry) อัตโนมัติหลัง Login"
                      IsChecked="True"
                      Margin="0,8,0,0"
                      FontWeight="Medium" />
            <CheckBox x:Name="FillVendorFromCsvCheckBox"
                      Content="กรอกรหัสผู้ขายจาก CSV อัตโนมัติ (input/input.csv)"
                      IsChecked="True"
                      Margin="0,6,0,0"
                      FontWeight="Medium" />
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="LoginButton"
                    Grid.Column="0"
                    Content="Login Prosoft"
                    Height="40"
                    FontWeight="SemiBold"
                    Background="{StaticResource BrandBrush}"
                    Foreground="White"
                    BorderThickness="0"
                    Margin="0,0,5,0"
                    Click="LoginButton_Click" />
            <Button x:Name="NavigateCreditPurchaseButton"
                    Grid.Column="1"
                    Content="เปิดหน้าซื้อเชื่อ"
                    Height="40"
                    FontWeight="SemiBold"
                    Background="#1976D2"
                    Foreground="White"
                    BorderThickness="0"
                    Margin="0,0,5,0"
                    Click="NavigateCreditPurchaseButton_Click" />
            <Button x:Name="FillVendorButton"
                    Grid.Column="2"
                    Content="กรอกผู้ขายจาก CSV"
                    Height="40"
                    FontWeight="SemiBold"
                    Background="#2E7D32"
                    Foreground="White"
                    BorderThickness="0"
                    Margin="0,0,5,0"
                    Click="FillVendorButton_Click" />
            <Button x:Name="ProcessGlButton"
                    Grid.Column="3"
                    Content="แท็บ GL &amp; Save"
                    Height="40"
                    FontWeight="SemiBold"
                    Background="#7B1FA2"
                    Foreground="White"
                    BorderThickness="0"
                    Margin="0,0,5,0"
                    Click="ProcessGlButton_Click" />
            <Button x:Name="CancelButton"
                    Grid.Column="4"
                    Content="Cancel"
                    Height="40"
                    MinWidth="65"
                    IsEnabled="False"
                    Click="CancelButton_Click" />
        </Grid>

        <Border Grid.Row="3"
                Background="#F5F5F5"
                BorderBrush="#E3E3E3"
                BorderThickness="1"
                CornerRadius="5"
                Padding="12"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Status" FontWeight="SemiBold" />
                <TextBlock x:Name="StatusText"
                           Text="พร้อม — กด Login, เปิดหน้าซื้อเชื่อ, กรอกผู้ขายจาก CSV หรือ แท็บ GL &amp; Save ได้ทันที"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="4"
                   Text="ถ้าเปิดหน้าซื้อเชื่อไว้อยู่แล้ว สามารถกดปุ่ม 'กรอกผู้ขายจาก CSV' (ระบบจะกรอกผู้ขาย, ภาษี NOVAT, หัวเอกสาร, สินค้า, แท็บ GL แผนก INTER และ Save ให้จบครบวงจร) หรือกด 'แท็บ GL &amp; Save' แยกเฉพาะส่วน GL ได้ทันที"
                   TextWrapping="Wrap"
                   FontSize="12"
                   Foreground="#666666" />

        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,8,0,0">
            <Button x:Name="LaunchProsoftButton"
                    Content="เปิด Prosoft"
                    Height="30"
                    Padding="14,0"
                    Margin="0,0,10,0"
                    Click="LaunchProsoftButton_Click" />
            <Button x:Name="ExportButton"
                    Content="Export UI Tree"
                    Height="30"
                    Padding="14,0"
                    Click="ExportButton_Click" />
        </StackPanel>
    </Grid>
</Window>
